{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ClickHub",
  "mainBinaryName": "clickhub",
  "version": "0.4.0",
  "identifier": "com.liamerens.clickhub",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "windows/hooks.nsh",
        "installerIcon": "icons/icon.ico"
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEVBNEU3Mzc5NkE1QjU4MzgKUldRNFdGdHFlWE5PNnQ2VjFlWldXUjNpNTN2VHFFeEhuTjlvTitJcDhzWklScVkrUk95SFFFTlMK",
      "endpoints": ["https://github.com/liamerens1/Clickhub/releases/latest/download/latest.json"],
      "requireSignedVersion": true,
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
