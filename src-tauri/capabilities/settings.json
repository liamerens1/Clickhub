{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "settings",
  "description": "The settings window: events plus the app's own commands (read and save config, pause, trigger capture, file picker, open folders).",
  "windows": ["settings"],
  "permissions": [
    "core:default",
    "allow-get-config",
    "allow-save-config",
    "allow-reload-config",
    "allow-get-status",
    "allow-set-paused",
    "allow-set-trigger-capture",
    "allow-pick-file",
    "allow-open-folder",
    "allow-get-app-info"
  ]
}
